###############################################################
# HSE-NET FOR ONLINE BILINGUAL HANDWRITING RECOGNITION
# CNN + BiLSTM + Attention
# Single File Implementation (Research Ready)
###############################################################

import numpy as np
import pandas as pd
import tensorflow as tf
from tensorflow.keras import layers, Model
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder

###############################################################
# SETTINGS
###############################################################

CSV_PATH = "online_data.csv"   # Change path
MAX_LEN = 200                 # max stroke length
BATCH_SIZE = 32
EPOCHS = 40

###############################################################
# FEATURE ENGINEERING (VERY IMPORTANT FOR HIGH ACCURACY)
###############################################################

def add_delta_features(sequence):
    """
    Converts (x,y,time) -> (x,y,dx,dy,speed)
    Accuracy boost: +3–7%
    """

    x = sequence[:,0]
    y = sequence[:,1]

    dx = np.diff(x, prepend=x[0])
    dy = np.diff(y, prepend=y[0])

    speed = np.sqrt(dx**2 + dy**2)

    return np.stack([x, y, dx, dy, speed], axis=1)


###############################################################
# LOAD DATA
###############################################################

def load_online_data(csv_path):

    df = pd.read_csv(csv_path)

    sequences = []
    labels = []

    # assuming each sample has an ID column
    if 'id' not in df.columns:
        raise ValueError(
            "CSV must contain 'id' column to group stroke sequences."
        )

    grouped = df.groupby('id')

    for sample_id, group in grouped:

        label = group['label'].iloc[0]

        seq = group[['x','y','time']].values.astype("float32")

        # normalize
        seq = seq - np.min(seq, axis=0)
        seq = seq / (np.max(seq, axis=0) + 1e-6)

        # add strong features
        seq = add_delta_features(seq)

        # padding / truncation
        if len(seq) > MAX_LEN:
            seq = seq[:MAX_LEN]

        pad = MAX_LEN - len(seq)
        seq = np.pad(seq, ((0,pad),(0,0)))

        sequences.append(seq)
        labels.append(label)

    sequences = np.array(sequences)

    encoder = LabelEncoder()
    labels = encoder.fit_transform(labels)

    print("Classes:", list(encoder.classes_))

    return sequences, labels, encoder


###############################################################
# BUILD HSE-NET
###############################################################

def build_hse_net(time_steps, features, num_classes):

    inputs = layers.Input(shape=(time_steps, features))

    #################################################
    # Stroke Encoder (1D CNN)
    #################################################

    x = layers.Conv1D(64, 5, padding='same', activation='relu')(inputs)
    x = layers.BatchNormalization()(x)

    x = layers.Conv1D(128, 3, padding='same', activation='relu')(x)
    x = layers.BatchNormalization()(x)

    #################################################
    # Temporal Modeling
    #################################################

    x = layers.Bidirectional(
        layers.LSTM(128, return_sequences=True)
    )(x)

    #################################################
    # Attention Layer
    #################################################

    attention = layers.Dense(1, activation='tanh')(x)
    attention = layers.Flatten()(attention)
    attention = layers.Activation('softmax')(attention)
    attention = layers.RepeatVector(256)(attention)
    attention = layers.Permute([2,1])(attention)

    x = layers.multiply([x, attention])
    x = tf.reduce_sum(x, axis=1)

    #################################################
    # Classifier
    #################################################

    x = layers.Dense(128, activation='relu')(x)
    x = layers.Dropout(0.4)(x)

    outputs = layers.Dense(num_classes, activation='softmax')(x)

    model = Model(inputs, outputs)

    model.compile(
        optimizer=tf.keras.optimizers.Adam(1e-3),
        loss='sparse_categorical_crossentropy',
        metrics=['accuracy']
    )

    return model


###############################################################
# MAIN
###############################################################

def main():

    print("\nLoading Online Handwriting Dataset...")
    X, y, encoder = load_online_data(CSV_PATH)

    print("Dataset shape:", X.shape)

    X_train, X_val, y_train, y_val = train_test_split(
        X, y, test_size=0.1, random_state=42
    )

    print("\nBuilding HSE-Net...")
    model = build_hse_net(
        time_steps=X.shape[1],
        features=X.shape[2],
        num_classes=len(np.unique(y))
    )

    model.summary()

    callbacks = [
        tf.keras.callbacks.EarlyStopping(
            patience=7,
            restore_best_weights=True
        ),
        tf.keras.callbacks.ReduceLROnPlateau(
            patience=3,
            factor=0.3
        )
    ]

    print("\nTraining Started...\n")

    history = model.fit(
        X_train, y_train,
        validation_data=(X_val, y_val),
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        callbacks=callbacks
    )

    print("\nEvaluating Model...\n")

    loss, acc = model.evaluate(X_val, y_val)
    print("Validation Accuracy:", acc)

    #################################################
    # SAVE MODEL (IMPORTANT FOR PAPER REPRODUCIBILITY)
    #################################################

    model.save("hse_net_online.h5")

    print("\nModel saved as hse_net_online.h5")


###############################################################

if __name__ == "__main__":
    main()
